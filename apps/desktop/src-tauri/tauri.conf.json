{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalabs Panel",
  "version": "0.1.0",
  "identifier": "dev.kalabs.panel",
  "build": {
    "devUrl": "https://www.kalabs.dev/admin",
    "frontendDist": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Kalabs Panel",
        "width": 1200,
        "height": 800,
        "url": "https://www.kalabs.dev/admin"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Usuarios en línea y visitas de los proyectos Kalabs."
  }
}
